import {
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
  "sayoi7799/moon_excalidraw/model",
  "sayoi7799/moon_excalidraw/export",
  "sayoi7799/moon_excalidraw/internal/fixtures",
}

pkgtype(kind: "executable")

options(
  targets: {
    "args_js.mbt": [ "js" ],
    "args_native.mbt": [ "native", "llvm", "wasm", "wasm-gc" ],
  },
)
